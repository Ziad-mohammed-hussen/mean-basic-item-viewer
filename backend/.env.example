# Server Configuration
PORT=3001
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:4201,http://localhost:4200

# MongoDB Atlas Configuration
# Database name must be: khutwa_db
MONGODB_DB_NAME=khutwa_db

# Provide credentials via MONGODB_USERNAME and MONGODB_PASSWORD,
# or supply the complete connection URI in MONGODB_URI.
# Special characters in MONGODB_USERNAME / MONGODB_PASSWORD are URL-encoded automatically when interpolated.
MONGODB_USERNAME=<USERNAME>
MONGODB_PASSWORD=<PASSWORD>
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.cyyf018.mongodb.net/khutwa_db?retryWrites=true&w=majority
